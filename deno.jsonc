{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
	"fmt": {
		"indentWidth": 4,
		"lineWidth": 800,
		"proseWrap": "preserve",
		"semiColons": true,
		"singleQuote": false,
		"useTabs": true
	},
	"imports": {
		"COLOR": "npm:color@5.0.3",
		"COLORNAMESPACELISTCOMMUNITY": "npm:color-name-list@14.47.0",
		"EXFETCH": "jsr:@hugoalh/exfetch@0.6.0",
		"FS": "jsr:@hugoalh/fs@0.4.0",
		"GHACTIONS": "jsr:@hugoalh/github-actions-core@0.7.0",
		"ISJSON": "jsr:@hugoalh/is-json@1.0.5",
		"STD/path": "jsr:@std/path@1.1.5",
		"STD/yaml": "jsr:@std/yaml@1.1.1",
		"STRINGDISSECT": "jsr:@hugoalh/string-dissect@4.0.2",
		"STRINGOVERFLOW": "jsr:@hugoalh/string-overflow@2.1.1"
	},
	"lint": {
		"plugins": [
			"jsr:@hugoalh/deno-lint-rules@^0.15.0/presets/library"
		],
		"rules": {
			"tags": [
				"recommended"
			],
			"exclude": [
				"no-import-prefix"
			],
			"include": [
				"default-param-last",
				"eqeqeq",
				"guard-for-in",
				"no-const-assign",
				"no-eval",
				"no-non-null-asserted-optional-chain",
				"no-self-compare",
				"no-slow-types",
				"no-sparse-arrays",
				"no-sync-fn-in-async-fn",
				"no-throw-literal",
				"no-undef",
				"no-useless-rename",
				"triple-slash-reference",
				"verbatim-module-syntax"
			]
		}
	},
	"lock": false,
	"minimumDependencyAge": {
		"age": "P1D"
	},
	"tasks": {
	},
	"unstable": [
	]
}
